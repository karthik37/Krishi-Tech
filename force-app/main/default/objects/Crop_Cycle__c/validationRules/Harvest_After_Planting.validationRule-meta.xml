<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Harvest_After_Planting</fullName>
    <active>true</active>
    <description>Harvest dates must come after planting date</description>
    <errorConditionFormula>AND( NOT(ISBLANK(Actual_Harvest_Date__c)), Actual_Harvest_Date__c &lt; Planting_Date__c )</errorConditionFormula>
    <errorDisplayField>Actual_Harvest_Date__c</errorDisplayField>
    <errorMessage>Harvest date cannot be before planting date. Please check your dates.</errorMessage>
</ValidationRule>
