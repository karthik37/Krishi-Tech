<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Expected_Harvest_After_Planting</fullName>
    <active>true</active>
    <errorConditionFormula>AND( NOT(ISBLANK(Expected_Harvest_Date__c)), Expected_Harvest_Date__c &lt;= Planting_Date__c )</errorConditionFormula>
    <errorDisplayField>Expected_Harvest_Date__c</errorDisplayField>
    <errorMessage>Expected harvest date must be after planting date.</errorMessage>
</ValidationRule>
